# SV13 TCG Duel Bot — secret-free environment template
# Never commit real Discord, storage, bot, debug, or webhook secrets.

NODE_ENV=production
PORT=3000

# Discord
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
ADMIN_ROLE_IDS=
ROLE_RECRUIT_ID=
ROLE_SUPPORTER_ID=
ROLE_ELITE_ID=
BATTLEFIELD_CHANNEL_ID=
ECONOMY_CHANNEL_ID=
MANAGE_CARDS_CHANNEL_ID=
MANAGE_DECK_CHANNEL_ID=
ADMIN_PAYOUT_CHANNEL_ID=
ADMIN_TOOLS_CHANNEL_ID=
FOUNDER_ROLE_ID=

# Public application API / UI bases
API_BASE=https://api.sv13tcg.com
HUB_UI=https://sv13tcg.com
CARD_COLLECTION_UI=https://collection.sv13tcg.com
DECK_BUILDER_UI=https://deck.sv13tcg.com
DUEL_UI=https://duel.sv13tcg.com
SPECTATOR_VIEW_UI=https://spectate.sv13tcg.com
DUEL_SUMMARY_UI=https://summary.sv13tcg.com
PLAYER_STATS_UI=https://stats.sv13tcg.com
LEADERBOARD_UI=https://leaderboard.sv13tcg.com
PACK_REVEAL_UI=https://packs.sv13tcg.com
RULEBOOK_UI=https://rules.sv13tcg.com
IMAGE_BASE=https://sv13tcg.com/assets/cards

# PRIVATE storage service — use the Railway private/internal URL when available.
PERSISTENT_DATA_URL=
# Must match sv13-tcg-data STORAGE_KEY at the coordinated Repo 1 + Repo 2 cutover.
STORAGE_KEY=
STORAGE_RETRIES=3
STORAGE_TIMEOUT_MS=12000
STORAGE_RETRY_BASE_MS=250

# Server-to-server / admin keys
BOT_API_KEY=
DEBUG_KEY=
TRADE_WEBHOOK_SECRET=

# Runtime / command synchronization safety
SAFE_MODE=false
SYNC_SCOPE=guild
LAST_RESORT_GLOBAL=false
SEND_SERVER_TRADE_DM=false

# Local same-service calls from Discord cogs. Leave blank to use 127.0.0.1:$PORT.
INTERNAL_BACKEND_URL=

# Migration flags
# Keep true only while old GitHub Pages UIs still need API access; set false after custom-domain cutover.
CORS_ALLOW_LEGACY_GITHUB=true
CORS_EXTRA_ORIGINS=
# api= is a compatibility override, not a required production query parameter.
PASS_API_QUERY=false

# Economy / game rules
CARD_PACK_COST=3
CARDS_PER_PACK=3
BUY_LIMIT_PER_DAY=5
SELL_LIMIT_PER_DAY=5
MAX_COLLECTION_SIZE=250
SELL_VALUE_COMMON=0.5
SELL_VALUE_UNCOMMON=1
SELL_VALUE_RARE=2
SELL_VALUE_LEGENDARY=3
WEIGHT_COMMON=5
WEIGHT_UNCOMMON=3
WEIGHT_RARE=2
WEIGHT_LEGENDARY=1
TRADE_LIMIT_PER_DAY=3
TRADE_TTL_HOURS=24
TRADE_MAX_CARDS_PER_SIDE=3
DUEL_STARTING_HP=200
DECK_MIN_SIZE=20
DECK_MAX_SIZE=40
DECK_MAX_COPIES=5
DUEL_OPENING_HAND=3
DUEL_HAND_LIMIT=4
DUEL_FIELD_LIMIT=4
PRACTICE_COUNTS_COMPETITIVE=false
LEADERBOARD_MIN_MATCHES=3

# HTTP hardening
API_JSON_LIMIT=512kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
DEBUG_MODE=false
